# Docker Compose service configuration
# MQTT_HOST uses the Docker Compose service name. Use localhost only when
# starting backend/robots directly outside Docker.
MQTT_HOST=mqtt
MQTT_PORT=1883
REPLAY_SPEED=5
LOG_LEVEL=INFO

# These URLs run in the browser, so they use host-mapped localhost ports.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
